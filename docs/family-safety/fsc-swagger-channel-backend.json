    "RequestTriggerCheckinPojo": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "Operation to perform",
          "enum": [
            "CREATE",
            "RESPONSE",
            "DISMISS",
            "PAUSE",
            "RESUME"
          ]
        },
        "triggerId": {
          "type": "string",
          "description": "Trigger Id (required for RESPONSE/DISMISS/PAUSE/RESUME; for CREATE pass client id or leave for system)"
        },
        "familyId": {
          "type": "string",
          "description": "[CREATE] Family Id"
        },
        "initiatorMsisdn": {
          "type": "string",
          "description": "[CREATE] Initiator MSISDN. [DISMISS/PAUSE/RESUME] actor MSISDN — Network validates it is an admin before applying (E4)."
        },
        "targetMsisdn": {
          "type": "string",
          "description": "[CREATE] Target MSISDN"
        },
        "scheduleType": {
          "type": "string",
          "description": "[CREATE] OneTime or Periodic",
          "enum": [
            "OneTime",
            "Periodic"
          ]
        },
        "scheduleTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "[CREATE] Time of day (HH:mm, local). One check-in per day (E2)."
        },
        "checkinTime": {
          "type": "string",
          "format": "date-time",
          "description": "[RESPONSE] Check-in timestamp"
        },
        "checkinResponse": {
          "type": "string",
          "description": "[RESPONSE] Check-in response"
        },
        "additionalData": {
          "type": "string",
          "description": "Additional data"
        },
        "scheduleDays": {
          "type": "array",
          "description": "[CREATE, Periodic] Days to run. All 7 = every day; MON-FRI = weekdays; or a custom subset (E2).",
          "items": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          }
        },
        "message": {
          "type": "string",
          "description": "[CREATE] Check-in message shown to the target member (E2)."
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "[CREATE] Schedule start date (E2)."
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "description": "[CREATE] Schedule end date; omit = runs until paused/dismissed, no fixed end (E2)."
        }
      },
      "title": "RequestTriggerCheckinPojo",
      "description": "Unified Check-in request (create / response / dismiss / pause / resume)"
    },
