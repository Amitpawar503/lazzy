      "get": {
        "tags": [
          "History Controller"
        ],
        "summary": "Retrieve consolidated alert & activity history for a family circle (check-in, SOS, fraud, alarm, device-status). Filter by member, type and date range.",
        "operationId": "fetchHistoryUsingGET",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
