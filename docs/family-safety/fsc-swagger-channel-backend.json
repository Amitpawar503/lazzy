  "definitions": {
    "RequestFamilyMemberPojo": {
      "type": "object",
      "required": [
        "airtelCustomer",
        "membershipStatus",
        "msisdn"
      ],
      "properties": {
        "airtelCustomer": {
          "type": "integer",
          "format": "int32",
          "description": "0 if Airtel customer else 1"
        },
        "circleMemberRole": {
          "type": "string",
          "description": "Role assigned to the family member",
          "enum": [
            "ADMIN",
            "SUB_ADMIN",
            "SPONSER",
            "MEMBER"
          ]
        },
        "familyId": {
          "type": "integer",
          "format": "int64",
          "description": "Unique identifier of the member (optional while creating member along with family)"
        },
        "membershipId": {
          "type": "integer",
          "format": "int64",
          "description": "Unique membership Id of the member (0 while creating new MemberShip)"
        },
        "membershipStatus": {
          "type": "string",
          "description": "Status of the family member",
          "enum": [
            "Active",
            "Inactive"
          ]
        },
        "msisdn": {
          "type": "string",
          "description": "MSISDN of the member"
        }
      },
      "title": "RequestFamilyMemberPojo",
      "description": "Request Family Member Details"
    },
    "RequestIncomingAlarmPojo": {
      "type": "object",
      "required": [
        "alarmId",
        "alarmTargetType",
        "alarmType",
        "initiatedBy"
      ],
      "properties": {
        "additionalData": {
          "type": "string",
          "description": "Any additional data related to Alarm"
        },
        "alarmId": {
          "type": "string",
          "description": "Unique Id of the incoming Alarm"
        },
        "alarmTargetType": {
          "type": "string",
          "description": "Target Type of the Alarm",
          "enum": [
            "Indivvidual",
            "Responder",
            "Broadcast"
          ]
        },
        "alarmType": {
          "type": "string",
          "description": "Type of Alarm to derive message template & channel"
        },
        "initiatedBy": {
          "type": "string",
          "description": "Value of MSISDN if generated by User else SYSTEM if generated from backend"
        },
        "targetFamilyId": {
          "type": "string",
          "description": "Target FamilyId required if AlarmTargetType is Responder OR Broadcast "
        },
        "targetMsisdn": {
          "type": "string",
          "description": "Target MSISDN required if AlarmTargetType is Individual "
        }
      },
      "title": "RequestIncomingAlarmPojo",
      "description": "Request Incoming Alarm Pojo"
    },
    "ResponseCheckinData": {
      "type": "object",
      "required": [
        "checkinRequestTime",
        "checkinStatus",
        "familyId",
        "initiatorMsisdn",
        "responseCheckinInfos",
        "scheduleTime",
        "scheduleType",
        "targetMsisdn"
      ],
      "properties": {
        "checkinRequestTime": {
          "type": "string",
          "format": "date-time",
          "description": "Time of the Checkin request"
        },
        "checkinStatus": {
          "type": "string",
          "description": "Current status of checkin",
          "enum": [
            "Active",
            "Dismissed",
            "Paused"
          ]
        },
        "familyId": {
          "type": "string",
          "description": "Family Id"
        },
        "initiatorMsisdn": {
          "type": "string",
          "description": "MSISDN of th Trigger Initiator"
        },
        "responseCheckinInfos": {
          "type": "array",
          "description": "List of Checkin Responses",
          "items": {
            "$ref": "#/definitions/ResponseCheckinInfo"
          }
        },
        "scheduleTime": {
          "type": "string",
          "format": "date-time",
          "description": "Schedule time of the Checkin Trigger"
        },
        "scheduleType": {
          "type": "string",
          "description": "Schedule type of the Checkin Trigger",
          "enum": [
            "OneTime",
            "Periodic"
          ]
        },
        "targetMsisdn": {
          "type": "string",
          "description": "Target MSISDN whose checkin is required"
        }
      },
      "title": "ResponseCheckinData",
      "description": "Response Checkin Data"
    },
    "ResponseCheckinInfo": {
      "type": "object",
      "required": [
        "checkinResponse",
        "checkinResponseStatus",
        "expectedDate",
        "lastUpdatedOn"
      ],
      "properties": {
        "checkinResponse": {
          "type": "string",
          "description": "Received Checkin Response"
        },
        "checkinResponseStatus": {
          "type": "string",
          "description": "Current status of checkin response",
          "enum": [
            "Pending",
            "Received",
            "Expired",
            "Dismissed"
          ]
        },
        "expectedDate": {
          "type": "string",
          "format": "date-time",
          "description": "Expected timestamp of checkin"
        },
        "lastUpdatedOn": {
          "type": "string",
          "format": "date-time",
          "description": "Status updated on Timestamp"
        }
      },
      "title": "ResponseCheckinInfo",
      "description": "Response Checkin Info"
    },
    "ResponseCheckinStatusPojo": {
      "type": "object",
      "required": [
        "responseCode",
        "responseMessage",
        "transactionId"
      ],
      "properties": {
        "responseCheckinDatas": {
          "type": "array",
          "description": "List of Checkins",
          "items": {
            "$ref": "#/definitions/ResponseCheckinData"
          }
        },
        "responseCode": {
          "type": "string",
          "description": "Response code of the request"
        },
        "responseMessage": {
          "type": "string",
          "description": "Response message"
        },
        "transactionId": {
          "type": "string",
          "description": "Unique transactionId of the request"
        }
      },
      "title": "ResponseCheckinStatusPojo",
      "description": "Response Checkin Status Pojo"
    },
    "ResponseDeviceStatus": {
      "type": "object",
      "required": [
        "propertyName",
        "propertyValue",
        "lastUpdatedOn"
      ],
      "properties": {
        "propertyName": {
          "type": "string",
          "description": "Name of the device property"
        },
        "propertyValue": {
          "type": "string",
          "description": "Value of the device property"
        },
        "lastUpdatedOn": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when this property value was last updated (E8)."
        }
      },
      "title": "ResponseDeviceStatus",
      "description": "Response Device Status"
    },
    "ResponseDeviceStatusDataPojo": {
      "type": "object",
      "required": [
        "deviceStatusInfos",
        "familyId"
      ],
      "properties": {
        "deviceStatusInfos": {
          "type": "array",
          "description": "List of device infos with status",
          "items": {
            "$ref": "#/definitions/ResponseDeviceStatusInfo"
          }
        },
        "familyId": {
          "type": "string",
          "description": "Family Id of the user"
        }
      },
      "title": "ResponseDeviceStatusDataPojo",
      "description": "Request Device Status Data Pojo"
    },
    "ResponseDeviceStatusInfo": {
      "type": "object",
      "required": [
        "deviceStatusList",
        "msisdn"
      ],
      "properties": {
        "deviceStatusList": {
          "type": "array",
          "description": "List of device properties status",
          "items": {
            "$ref": "#/definitions/ResponseDeviceStatus"
          }
        },
        "msisdn": {
          "type": "string",
          "description": "MSISDN of the user"
        }
      },
      "title": "ResponseDeviceStatusInfo",
      "description": "Response Device Status Info"
    },
    "ResponseFamilyMemberPojo": {
      "type": "object",
      "required": [
        "responseCode",
        "responseMessage",
        "transactionId"
      ],
      "properties": {
        "familyMemberInfos": {
          "type": "array",
          "description": "Members (one element when memberId supplied)",
          "items": {
            "$ref": "#/definitions/ResponseFamilyMemberInfo"
          }
        },
        "responseCode": {
          "type": "string"
        },
        "responseMessage": {
          "type": "string"
        },
        "transactionId": {
          "type": "string"
        }
      },
      "title": "ResponseFamilyMemberPojo",
      "description": "Response Family Member Details (list-capable; MERGED get + getAll)"
    },
    "ResponseFamilyPojo": {
      "type": "object",
      "required": [
        "familyDescription",
        "familyName",
        "familyStatus",
        "responseCode",
        "responseMessage",
        "transactionId"
      ],
      "properties": {
        "familyDescription": {
          "type": "string",
          "description": "Description of the family"
        },
        "familyId": {
          "type": "integer",
          "format": "int64",
          "description": "Unique identifier of the family"
        },
        "familyMemberPojos": {
          "type": "array",
          "description": "List of family members",
          "items": {
            "$ref": "#/definitions/RequestFamilyMemberPojo"
          }
        },
        "familyName": {
          "type": "string",
          "description": "Name of the family"
        },
        "familyStatus": {
          "type": "string",
          "description": "Status of the family",
