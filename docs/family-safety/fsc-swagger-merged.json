  "definitions": {
    "RequestDeviceStatus": {
      "type": "object",
      "required": [
        "propertyName",
        "propertyValue"
      ],
      "properties": {
        "propertyName": {
          "type": "string",
          "description": "Name of the device property"
        },
        "propertyValue": {
          "type": "string",
          "description": "Value of the device property"
        }
      },
      "title": "RequestDeviceStatus",
      "description": "Request Device Status"
    },
    "RequestDeviceStatusDataPojo": {
      "type": "object",
      "required": [
        "dataId",
        "deviceStatusList",
        "familyId",
        "msisdn"
      ],
      "properties": {
        "additionalData": {
          "type": "string",
          "description": "Additional data related to SOS creation"
        },
        "dataId": {
          "type": "string",
          "description": "Unique Id of the Data"
        },
        "deviceStatusList": {
          "type": "array",
          "description": "List of device properties status",
          "items": {
            "$ref": "#/definitions/RequestDeviceStatus"
          }
        },
        "familyId": {
          "type": "string",
          "description": "Family Id of the user"
        },
        "msisdn": {
          "type": "string",
          "description": "MSISDN of the user"
        }
      },
      "title": "RequestDeviceStatusDataPojo",
      "description": "Request Device Status Data Pojo"
    },
    "RequestFamilyMemberPojo": {
      "type": "object",
      "required": [
        "airtelCustomer",
        "membershipStatus",
        "msisdn"
      ],
