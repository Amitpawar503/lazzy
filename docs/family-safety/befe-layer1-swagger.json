{
  "swagger": "2.0",
  "info": {
    "title": "Family Safety — BEFE Layer-1 (App → Channel BE)",
    "version": "1.0",
    "description": "App-facing BEFE aggregate APIs that land on Channel BE. THREE reads cover the Safety Circle screens: (1) GET /home = Family + members + relations + roles/responders + ACTIVE SERVICES (network) + SIGNALS (fans out to FSC family/get + member/get(all) + device/status/fetch + UCM titles + history count); (2) GET /members/{membershipId} = member services (FSC member/get) + full DEVICE STATUS (FSC device/status/fetch) + check-in status; (3) GET /history = FSC history/fetch. Response carries everything the UI + BEFE requirements need so the app makes one call per screen."
  },
  "host": "guardian.airtel.com",
  "basePath": "/befe/fsc/v1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "tags": [
    {
      "name": "Home",
      "description": "Family / Home aggregate"
    },
    {
      "name": "Member",
      "description": "Member detail aggregate"
    },
    {
      "name": "History",
      "description": "Alerts & activity history"
    }
  ],
  "paths": {
