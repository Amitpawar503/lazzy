    "/history": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "Consolidated alert & activity history (FSC history/fetch). Filters by member/type/date; role-scoped.",
        "operationId": "getHistory",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "familyId",
            "in": "query",
            "description": "Family id",
            "required": true,
            "type": "string"
          },
          {
            "name": "msisdn",
            "in": "query",
            "description": "Filter to a member",
            "required": false,
            "type": "string"
          },
          {
            "name": "eventType",
            "in": "query",
            "description": "Filter",
            "required": false,
            "type": "string",
            "enum": [
              "CHECK_IN",
              "SOS",
              "FRAUD",
              "ALARM",
              "DEVICE_STATUS"
            ]
          },
          {
            "name": "scope",
            "in": "query",
            "description": "active|history|all",
            "required": false,
            "type": "string",
            "enum": [
              "active",
              "history",
              "all"
            ]
          },
          {
            "name": "role",
            "in": "query",
            "description": "Caller role for visibility",
            "required": false,
            "type": "string",
            "enum": [
              "ADMIN",
              "CO_ADMIN",
              "MEMBER",
              "RESPONDER"
            ]
          },
          {
            "name": "fromDate",
            "in": "query",
            "description": "yyyy-MM-dd",
            "required": false,
            "type": "string",
            "format": "date"
          },
          {
            "name": "toDate",
            "in": "query",
            "description": "yyyy-MM-dd",
            "required": false,
            "type": "string",
            "format": "date"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/HistoryResponse"
            },
            "examples": {
              "application/json": {
                "historyInfos": [
                  {
                    "eventId": "H101",
                    "eventType": "CHECK_IN",
                    "eventTimestamp": "2026-11-26T09:04:00Z",
                    "memberMsisdn": "919812300002",
                    "displayName": "Mom",
                    "status": "Received",
                    "message": "Mom replied 'I'm fine' to the 9:00 am check-in"
                  },
                  {
