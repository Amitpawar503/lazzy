  },
  "definitions": {
    "Signals": {
      "type": "object",
      "title": "Signals",
      "description": "Per-member signals — device (battery/ringer) + network (reachability/strength/SIM)",
      "properties": {
        "reachabilityReason": {
          "type": "string",
          "description": "From Network",
          "enum": [
            "REACHABLE",
            "SWITCHED_OFF",
            "NO_COVERAGE",
            "SWITCHED_OFF_OR_FLIGHT",
            "BATTERY_DEAD",
            "INACTIVE_NUMBER"
          ]
        },
        "batteryPercent": {
          "type": "integer",
          "format": "int32",
          "description": "0-100 (device)"
        },
        "lastBatteryLevel": {
          "type": "integer",
          "format": "int32",
          "description": "Last battery before offline"
        },
        "charging": {
          "type": "boolean"
        },
        "ringerMode": {
          "type": "string",
          "description": "device",
          "enum": [
            "NORMAL",
            "VIBRATE",
            "SILENT"
          ]
        },
        "networkType": {
          "type": "string",
          "enum": [
            "WIFI",
            "5G",
            "4G",
            "3G",
            "2G",
            "NO_NETWORK"
          ]
        },
        "networkStrength": {
          "type": "string",
          "enum": [
            "STRONG",
            "MODERATE",
            "WEAK",
            "NONE"
          ]
        },
        "lastOnNetworkAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUpdatedOn": {
          "type": "string",
          "format": "date-time"
        },
        "available": {
          "type": "boolean",
          "description": "False when signal unavailable e.g. iPhone ringer / non-Airtel"
        }
      }
    },
    "ServiceStatus": {
      "type": "object",
      "title": "ServiceStatus",
      "description": "Active-service availability/health per member (from Network)",
      "properties": {
        "service": {
          "type": "string",
          "enum": [
            "CHECKIN",
            "SOS",
            "FRAUD_SPAM",
            "REACHABILITY",
            "SAFE_TRIP",
            "DEVICE_SAFETY",
            "PARENTAL_CONTROLS"
          ]
        },
        "available": {
          "type": "boolean",
          "description": "Service available for this member (e.g. SPAM Airtel-only)"
        },
        "working": {
          "type": "boolean",
          "description": "Functional now (app + permissions ok)"
        },
        "status": {
          "type": "string",
          "enum": [
            "WORKING",
            "NOT_WORKING",
            "MISSING_PERMISSION",
            "NOT_SUBSCRIBED",
            "NOT_AVAILABLE"
          ]
        },
        "missingPermission": {
          "type": "string",
          "description": "e.g. LOCATION when SOS not working"
        }
      },
      "required": [
        "service"
      ]
    },
    "AlertSummary": {
      "type": "object",
      "title": "AlertSummary",
      "description": "Highest-priority active alert on a card",
      "properties": {
        "alertId": {
          "type": "string"
        },
        "alertType": {
          "type": "string",
          "enum": [
            "SOS",
            "CHECKIN",
            "CHECKIN_NEED_HELP",
            "FRAUD_SPAM",
            "LOW_BATTERY",
            "BACK_ONLINE",
            "GEOFENCE",
            "DEVICE_SAFETY",
            "CIRCLE_EVENT",
            "PARENTAL_REQUEST"
          ]
        },
        "status": {
          "type": "string"
        },
        "createdOn": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "alertType"
      ]
    },
    "MemberCard": {
      "type": "object",
      "title": "MemberCard",
      "description": "Home member card — identity + relation + role + signals + active services",
      "properties": {
        "membershipId": {
          "type": "string"
        },
        "msisdn": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "relationship": {
          "type": "string",
          "description": "Mom/Dad/... (UCM)"
        },
        "airtelCustomer": {
          "type": "integer",
          "format": "int32",
          "description": "0 Airtel else 1"
        },
        "role": {
          "type": "string",
          "enum": [
            "ADMIN",
            "CO_ADMIN",
            "SUB_ADMIN",
            "SPONSER",
            "MEMBER"
          ]
        },
        "isResponder": {
          "type": "boolean"
        },
        "membershipStatus": {
          "type": "string",
          "enum": [
            "Active",
            "InvitePending",
            "Paused",
            "Inactive"
          ]
        },
        "signals": {
          "$ref": "#/definitions/Signals"
        },
        "activeServices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServiceStatus"
          }
        },
        "latestCheckInSummary": {
          "type": "string",
          "description": "e.g. 'Replied I'm fine at 9:04'"
        },
        "activeAlert": {
          "$ref": "#/definitions/AlertSummary"
        },
        "featuresBrokenHint": {
          "type": "string",
          "description": "e.g. 'Location off, SOS wont share location'"
        }
      },
      "required": [
        "membershipId",
        "msisdn"
      ]
    },
    "Subscription": {
      "type": "object",
      "title": "Subscription",
      "description": "",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Active",
            "Trial",
            "Expiring",
            "Paused",
            "Closing",
            "None"
          ]
        },
        "planId": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "banners": {
          "type": "array",
          "items": "string"
        }
      }
    },
    "HistoryItem": {
      "type": "object",
      "title": "HistoryItem",
      "description": "One alert/activity entry (FSC history/fetch)",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "CHECK_IN",
            "SOS",
            "FRAUD",
            "ALARM",
            "DEVICE_STATUS"
          ]
        },
        "eventTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "memberMsisdn": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "description": "relation/name via UCM"
        },
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "description": "human-readable summary"
        },
        "additionalData": {
          "type": "string"
        }
      },
      "required": [
        "eventId",
        "eventType"
      ]
    },
    "HomeResponse": {
      "type": "object",
      "title": "HomeResponse",
      "description": "Family/Home aggregate — FSC family/get + member/get(all) + device/status/fetch + UCM titles + history count",
      "properties": {
        "familyId": {
          "type": "string"
        },
        "familyName": {
          "type": "string"
