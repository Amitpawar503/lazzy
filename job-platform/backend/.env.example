# Copy to .env and adjust. All values are optional (sensible defaults apply).

# --- Core ---
DATABASE_URL=sqlite:///./careerhound.db
# For Postgres: postgresql+psycopg://user:pass@localhost:5432/careerhound
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ingestion ---
INGEST_INTERVAL_SECONDS=900
INGEST_ON_STARTUP=true
INGEST_MAX_PER_SOURCE=500
INGEST_REQUEST_DELAY=0.5

# --- AI (optional) ---
# Set this to enable AI-powered matching, re-ranking and resume enhancement.
# Without it the app falls back to TF-IDF matching + rule-based enhancement.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MATCH_MAX_JOBS=40
