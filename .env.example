# Copy to .env and fill in what you have. Everything is optional — the app
# degrades to free sources / bundled sample data. NEVER commit your real .env.

# --- App ---
APP_NAME=Lazzy Markets
ENV=dev
CORS_ORIGINS=*
ALLOW_SAMPLE_FALLBACK=true
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0

# --- Live data ---
# Market-data provider:
#   sample   = fast synthetic data, no network (default)
#   fmp      = Financial Modeling Prep — FULL NSE market (set FMP_API_KEY below)
#   dhan     = DhanHQ v2 — LIVE feed + 20-level depth + daily history (demat acct)
#   yfinance = Yahoo Finance per symbol (pip install yfinance)
DATA_PROVIDER=sample
# If the primary provider can't serve at runtime (e.g. Dhan Data APIs not
# subscribed → DH-902), auto-fall back to this FREE provider before sample:
DATA_PROVIDER_FALLBACK=yfinance   # yfinance (Yahoo, no key) | fmp | sample
FMP_API_KEY=                 # financialmodelingprep.com — needed for DATA_PROVIDER=fmp
UNIVERSE_LIMIT=750           # how many stocks to load for the full market (by mcap)
LIVE_DATA=false              # legacy switch; equivalent to DATA_PROVIDER=yfinance
HISTORY_DAYS=400

# --- DhanHQ v2 (live NSE/BSE — needs a free Dhan demat account) ---------------
# docs.dhanhq.co/api/v2/data-apis — Live Market Feed + Full Market Depth (20-level)
# + Daily Historical. Get the token from web.dhan.co → DhanHQ Trading APIs.
# pip install dhanhq   (optional — enables the websocket push feed & 20-level depth;
# without it the REST batch-quote poller still gives seconds-fresh live prices).
DHAN_CLIENT_ID=              # your Dhan client / user id
DHAN_ACCESS_TOKEN=          # DhanHQ data-API access token (JWT)
DHAN_RATE_LIMIT=5           # max REST calls/sec (Dhan's limit is 5/sec; throttled client-side)
# Persist history to JSON on disk so it isn't re-fetched (refreshed daily):
# DATA_STORE_DIR=./data_store
COMPUTE_WORKERS=8
# Live news from free RSS (Moneycontrol/ET/Livemint/BS/Reuters/CNBC) + Finnhub.
# No login needed for RSS; set FINNHUB_API_KEY below for extra global + company news.
NEWS_LIVE=true

# --- Free / freemium AI providers (Phase 4) ---
# All free or with a usable free tier. Ollama needs no key (runs locally).
GROQ_API_KEY=              # console.groq.com — free, very fast
GEMINI_API_KEY=           # aistudio.google.com — free tier
TOGETHER_API_KEY=         # api.together.xyz — free credits
HF_TOKEN=                 # huggingface.co — free Inference API
NVIDIA_API_KEY=           # build.nvidia.com — free credits
CLOUDFLARE_ACCOUNT_ID=    # Cloudflare Workers AI — free daily allocation
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=       # openrouter.ai — has :free models
MISTRAL_API_KEY=          # console.mistral.ai — free tier
CEREBRAS_API_KEY=         # cloud.cerebras.ai — free tier, fast
SAMBANOVA_API_KEY=        # cloud.sambanova.ai — free tier
GLM_API_KEY=              # open.bigmodel.cn — Zhipu GLM free tier
BFL_API_KEY=              # blackforestlabs.ai — image gen
FAL_API_KEY=              # fal.ai — media
OLLAMA_BASE_URL=          # e.g. http://localhost:11434 — local, no key

# --- Data / news providers (optional free tiers) ---
# For LIVE NEWS: RSS works with no key. Add a free key below for more coverage:
#   FINNHUB_API_KEY (global + company news), NEWSAPI_KEY (aggregates Reuters/CNBC/
#   Bloomberg/ET/…). Get free keys at finnhub.io and newsapi.org.
TAPETIDE_TOKEN=
ALPHAVANTAGE_API_KEY=      # alphavantage.co — free stock data + news sentiment
FINNHUB_API_KEY=          # finnhub.io — free real-time-ish quotes + market news
NEWSAPI_KEY=              # newsapi.org — free tier, aggregates many news outlets
MARKETSTACK_KEY=          # marketstack.com — free tier REST market data

# --- Data-site logins (no official API; optional; used for scraping/feeds) ---
# Respect each site's ToS and rate limits. Keep these ONLY in .env (git-ignored).
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=
CHARTINK_USERNAME=
CHARTINK_PASSWORD=
SCREENER_EMAIL=
SCREENER_PASSWORD=
MONEYCONTROL_USERNAME=
MONEYCONTROL_PASSWORD=

# --- Broker credentials (later phase; keep encrypted at rest) ---
KITE_API_KEY=
KITE_API_SECRET=
FYERS_APP_ID=
FYERS_SECRET=
